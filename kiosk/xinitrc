#!/bin/bash
# Grafana kiosk X11 session — METRICSSERVER HDMI display
# Gestart via startx vanuit ~/.bash_profile (autologin tty1)
# Chromium herstart automatisch bij crash

# Scherm nooit uitschakelen
xset s off
xset -dpms
xset s noblank

# Cursor verbergen na 1 seconde inactiviteit
unclutter -idle 1 -root &

# Minimale window manager (nodig voor Chromium)
openbox &

sleep 2

# Chromium in kiosk mode — Grafana temperaturen dashboard
CHROME_BIN=""
for candidate in chromium-browser chromium google-chrome-stable google-chrome; do
    if command -v "$candidate" &>/dev/null; then
        CHROME_BIN="$candidate"
        break
    fi
done

if [[ -z "$CHROME_BIN" ]]; then
    echo "FOUT: geen Chromium/Chrome gevonden" | tee /tmp/kiosk-error.log
    exit 1
fi

# Loop: herstart Chromium bij crash
while true; do
    "$CHROME_BIN" \
        --kiosk \
        --noerrdialogs \
        --disable-infobars \
        --no-first-run \
        --disable-translate \
        --disable-extensions \
        --disable-component-update \
        --check-for-update-interval=31536000 \
        --disable-features=TranslateUI \
        --password-store=basic \
        --disable-session-crashed-bubble \
        --disable-restore-session-state \
        "http://metrics.hostinglocal.be/d/serverrack-kiosk?kiosk&refresh=30s&theme=dark"
    sleep 5
done
