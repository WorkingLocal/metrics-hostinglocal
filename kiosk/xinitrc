#!/bin/bash
# Grafana kiosk X11 sessie — METRICSSERVER HDMI display
# Gestart via startx vanuit ~/.bash_profile (autologin tty1)
# Dashboard rotatie via kiosk-rotate.html (JS iframe, 25s interval, 5 dashboards)
# Beheer: kiosk/kiosk-rotate.html in metrics-hostinglocal repo

sleep 1
xrandr --output HDMI-1 --mode 1920x1080 --rate 60 2>/dev/null || \
xrandr --output HDMI-A-1 --mode 1920x1080 --rate 60 2>/dev/null || true

xset s off
xset -dpms
xset s noblank

unclutter -idle 1 -root &
openbox &

# Lokale HTTP server voor kiosk-rotate.html (vermijdt file:// iframe beperkingen)
python3 -m http.server 8080 --directory /opt/metrics-hostinglocal/kiosk \
    >> /tmp/kiosk-http.log 2>&1 &
sleep 2

CHROME_BIN=""
for candidate in chromium-browser chromium google-chrome-stable google-chrome; do
    if command -v "$candidate" &>/dev/null; then
        CHROME_BIN="$candidate"
        break
    fi
done

if [[ -z "$CHROME_BIN" ]]; then
    echo "FOUT: geen Chromium/Chrome gevonden" | tee /tmp/kiosk-error.log
    exit 1
fi

KIOSK_URL="http://localhost:8080/kiosk-rotate.html"

while true; do
    "$CHROME_BIN" \
        --kiosk \
        --noerrdialogs \
        --disable-infobars \
        --no-first-run \
        --disable-translate \
        --disable-extensions \
        --disable-component-update \
        --check-for-update-interval=31536000 \
        --disable-features=TranslateUI \
        --password-store=basic \
        --disable-session-crashed-bubble \
        --disable-restore-session-state \
        --disk-cache-size=1 \
        --disable-background-timer-throttling \
        --disable-renderer-backgrounding \
        "$KIOSK_URL"
    sleep 5
done
