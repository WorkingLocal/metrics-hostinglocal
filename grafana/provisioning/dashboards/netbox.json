{
  "title": "NetBox — Inventaris & Gezondheid",
  "uid": "netbox-hl",
  "description": "NetBox 4.x inventaris via REST API (Infinity) + applicatie metrics via django-prometheus",
  "timezone": "browser",
  "refresh": "2m",
  "schemaVersion": 38,
  "version": 2,
  "time": { "from": "now-3h", "to": "now" },
  "tags": ["netbox", "ipam"],
  "panels": [

    {
      "id": 50,
      "type": "row",
      "title": "Inventaris (live via NetBox API)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "id": 51,
      "type": "stat",
      "title": "Devices",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-netbox" },
        "type": "json", "source": "url", "format": "dataframe",
        "url": "/api/dcim/devices/?limit=1&format=json",
        "method": "GET",
        "root_selector": "",
        "columns": [{ "selector": "count", "text": "Devices", "type": "number" }]
      }],
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-netbox" }
    },

    {
      "id": 52,
      "type": "stat",
      "title": "IP Adressen",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-netbox" },
        "type": "json", "source": "url", "format": "dataframe",
        "url": "/api/ipam/ip-addresses/?limit=1&format=json",
        "method": "GET",
        "root_selector": "",
        "columns": [{ "selector": "count", "text": "IP Adressen", "type": "number" }]
      }],
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-netbox" }
    },

    {
      "id": 53,
      "type": "stat",
      "title": "Prefixes",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] } }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-netbox" },
        "type": "json", "source": "url", "format": "dataframe",
        "url": "/api/ipam/prefixes/?limit=1&format=json",
        "method": "GET",
        "root_selector": "",
        "columns": [{ "selector": "count", "text": "Prefixes", "type": "number" }]
      }],
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-netbox" }
    },

    {
      "id": 54,
      "type": "stat",
      "title": "Virtual Machines",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] } }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-netbox" },
        "type": "json", "source": "url", "format": "dataframe",
        "url": "/api/virtualization/virtual-machines/?limit=1&format=json",
        "method": "GET",
        "root_selector": "",
        "columns": [{ "selector": "count", "text": "VMs", "type": "number" }]
      }],
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-netbox" }
    },

    {
      "id": 55,
      "type": "stat",
      "title": "Cables",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "semi-dark-blue" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "semi-dark-blue", "value": null }] } }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-netbox" },
        "type": "json", "source": "url", "format": "dataframe",
        "url": "/api/dcim/cables/?limit=1&format=json",
        "method": "GET",
        "root_selector": "",
        "columns": [{ "selector": "count", "text": "Cables", "type": "number" }]
      }],
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-netbox" }
    },

    {
      "id": 56,
      "type": "stat",
      "title": "Services",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "yellow" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "yellow", "value": null }] } }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-netbox" },
        "type": "json", "source": "url", "format": "dataframe",
        "url": "/api/ipam/services/?limit=1&format=json",
        "method": "GET",
        "root_selector": "",
        "columns": [{ "selector": "count", "text": "Services", "type": "number" }]
      }],
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-netbox" }
    },

    {
      "id": 1,
      "type": "row",
      "title": "Actueel",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },

    {
      "id": 2,
      "type": "stat",
      "title": "HTTP Request Rate",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(django_http_requests_total_by_method_total{job=\"netbox-app\"}[5m]))",
          "legendFormat": "req/s",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "REST API Requests",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(rest_api_requests_total_by_method_total{job=\"netbox-app\"}[5m]))",
          "legendFormat": "REST req/s",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "GraphQL Requests",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "purple", "value": null }]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(graphql_api_requests_total{job=\"netbox-app\"}[5m]))",
          "legendFormat": "GraphQL req/s",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Foutpercentage (5xx)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "noValue": "0%",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(django_http_responses_total_by_status_total{job=\"netbox-app\", status=~\"5..\"}[5m])) / sum(rate(django_http_responses_total_by_status_total{job=\"netbox-app\"}[5m]))",
          "legendFormat": "5xx %",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 6,
      "type": "stat",
      "title": "p95 Latency",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"netbox-app\"}[5m])))",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 7,
      "type": "stat",
      "title": "DB Queries/s",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(django_db_execute_total{job=\"netbox-app\"}[5m]))",
          "legendFormat": "queries/s",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 10,
      "type": "row",
      "title": "HTTP Tijdreeksen",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "HTTP Responses per status code",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "2\\d\\d" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "3\\d\\d" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "4\\d\\d" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "5\\d\\d" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(django_http_responses_total_by_status_total{job=\"netbox-app\"}[5m]))",
          "legendFormat": "{{status}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "Request Latency Percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"netbox-app\"}[5m])))",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"netbox-app\"}[5m])))",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"netbox-app\"}[5m])))",
          "legendFormat": "p99",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 20,
      "type": "row",
      "title": "Database & API",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },

    {
      "id": 21,
      "type": "timeseries",
      "title": "Database Query Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(django_db_execute_total{job=\"netbox-app\"}[5m]))",
          "legendFormat": "DB queries/s",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "sum(rate(django_db_new_connections_total{job=\"netbox-app\"}[5m]))",
          "legendFormat": "Nieuwe DB connecties/s",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 22,
      "type": "timeseries",
      "title": "REST API & GraphQL Requests per methode",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (method) (rate(rest_api_requests_total_by_method_total{job=\"netbox-app\"}[5m]))",
          "legendFormat": "REST {{method}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "sum(rate(graphql_api_requests_total{job=\"netbox-app\"}[5m]))",
          "legendFormat": "GraphQL",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    }

  ],

  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Datasource",
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  }
}
