{
  "title": "Homelab Overview",
  "uid": "homelab-overview-hl",
  "description": "Overzicht van alle Hosting Local nodes — CPU, RAM, schijf en status",
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 38,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["overview", "homelab", "signage"],
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "Status",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Nodes Online",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "auto",
        "text": { "valueSize": 48 }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(up{job!=\"prometheus\"} == 1)",
          "legendFormat": "Online",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Nodes Offline",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "text": { "valueSize": 48 }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(up{job!=\"prometheus\"} == 0) or vector(0)",
          "legendFormat": "Offline",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Totaal Gemonitord",
      "gridPos": { "h": 4, "w": 4, "x": 10, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "text": { "valueSize": 48 }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(up{job!=\"prometheus\"})",
          "legendFormat": "Totaal",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 10,
      "type": "row",
      "title": "CPU Gebruik",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },

    {
      "id": 11,
      "type": "bargauge",
      "title": "CPU % — Linux Nodes (node_exporter)",
      "gridPos": { "h": 14, "w": 16, "x": 0, "y": 6 },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "text": { "valueSize": 14 }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 12,
      "type": "bargauge",
      "title": "CPU % — Windows + HAOS",
      "gridPos": { "h": 14, "w": 8, "x": 16, "y": 6 },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "text": { "valueSize": 14 }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(windows_cpu_time_total{mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "100 - sum by (instance) (netdata_system_cpu_percentage_average{instance=\"HAOS-NUC\", dimension=\"idle\"})",
          "legendFormat": "{{instance}}",
          "refId": "B",
          "instant": true
        }
      ]
    },

    {
      "id": 20,
      "type": "row",
      "title": "RAM Gebruik",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "collapsed": false
    },

    {
      "id": 21,
      "type": "bargauge",
      "title": "RAM % — Linux Nodes",
      "gridPos": { "h": 14, "w": 16, "x": 0, "y": 21 },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "text": { "valueSize": 14 }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 22,
      "type": "bargauge",
      "title": "RAM % — Windows",
      "gridPos": { "h": 14, "w": 8, "x": 16, "y": 21 },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "text": { "valueSize": 14 }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - (windows_os_physical_memory_free_bytes{instance=\"WINDOWSSERVER2025\"} / windows_cs_physical_memory_bytes{instance=\"WINDOWSSERVER2025\"} * 100)",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 30,
      "type": "row",
      "title": "Schijfgebruik (root /)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "collapsed": false
    },

    {
      "id": 31,
      "type": "bargauge",
      "title": "Schijf % — root / (Linux Nodes)",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 36 },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "text": { "valueSize": 14 }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - (node_filesystem_avail_bytes{mountpoint=\"/\", fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\", fstype!=\"tmpfs\"} * 100)",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 40,
      "type": "row",
      "title": "CPU over Tijd — Alle Nodes",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 50 },
      "collapsed": false
    },

    {
      "id": 41,
      "type": "timeseries",
      "title": "CPU gebruik over tijd — Linux Nodes",
      "gridPos": { "h": 10, "w": 14, "x": 0, "y": 51 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 1, "fillOpacity": 5 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 42,
      "type": "timeseries",
      "title": "RAM gebruik over tijd — Linux Nodes",
      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 51 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 1, "fillOpacity": 5 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    }

  ]
}
