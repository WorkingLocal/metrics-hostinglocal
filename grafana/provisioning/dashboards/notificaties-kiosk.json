{
  "title": "Serverrack Kiosk — NTFY Meldingen",
  "uid": "serverrack-ntfy",
  "description": "FHD kiosk scherm 4 — NTFY meldingen ticker (links) + statistieken (rechts)",
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 38,
  "version": 1,
  "time": { "from": "now-24h", "to": "now" },
  "tags": ["kiosk", "ntfy"],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "options": {
        "content": "## NTFY Meldingen",
        "mode": "markdown",
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false }
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Recente meldingen — 12u",
      "gridPos": { "h": 35, "w": 12, "x": 0, "y": 1 },
      "options": {
        "frameIndex": 0,
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "time" },
            "properties": [
              { "id": "custom.width", "value": 100 },
              { "id": "displayName", "value": "Tijd" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "title" },
            "properties": [
              { "id": "custom.width", "value": 200 },
              { "id": "displayName", "value": "Titel" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "message" },
            "properties": [
              { "id": "displayName", "value": "Bericht" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "priority" },
            "properties": [
              { "id": "custom.width", "value": 40 },
              { "id": "displayName", "value": "P" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "blue", "value": null },
                    { "color": "text", "value": 3 },
                    { "color": "orange", "value": 4 },
                    { "color": "red", "value": 5 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "tags" },
            "properties": [
              { "id": "custom.width", "value": 80 },
              { "id": "displayName", "value": "Tags" }
            ]
          }
        ]
      },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://alertmanager-ntfy:9095/ntfy-messages",
          "url_options": { "method": "GET", "data": "" },
          "parser": "backend",
          "json_options": { "root_selector": "", "columns": [] }
        }
      ]
    },
    {
      "id": 3,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": { "h": 1, "w": 12, "x": 12, "y": 1 },
      "options": {
        "content": "## Statistieken",
        "mode": "markdown",
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false }
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Laatste uur",
      "description": "Aantal NTFY berichten in de laatste 1 uur",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 2 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "text": { "valueSize": 64, "titleSize": 20 }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 },
              { "color": "yellow", "value": 20 },
              { "color": "orange", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ntfy_topic_message_count{period=\"1h\"}",
          "legendFormat": "1u",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Laatste 24u",
      "description": "Aantal NTFY berichten in de laatste 24 uur",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 2 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "text": { "valueSize": 64, "titleSize": 20 }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 },
              { "color": "yellow", "value": 20 },
              { "color": "orange", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ntfy_topic_message_count{period=\"24h\"}",
          "legendFormat": "24u",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": { "h": 1, "w": 12, "x": 12, "y": 7 },
      "options": {
        "content": "## Prioriteiten — 24u",
        "mode": "markdown",
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false }
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Urgente berichten",
      "description": "Priority 5 (urgent) berichten in 24u",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "text": { "valueSize": 64, "titleSize": 20 }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ntfy_topic_message_count_by_priority{period=\"24h\", priority=\"urgent\"}",
          "legendFormat": "Urgent",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "High priority",
      "description": "Priority 4 (high) berichten in 24u",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "text": { "valueSize": 64, "titleSize": 20 }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ntfy_topic_message_count_by_priority{period=\"24h\", priority=\"high\"}",
          "legendFormat": "High",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": { "h": 1, "w": 12, "x": 12, "y": 13 },
      "options": {
        "content": "## Activiteit — 24u",
        "mode": "markdown",
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false }
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "NTFY Activiteit",
      "description": "Berichtenaantal per periode over de afgelopen 24 uur",
      "gridPos": { "h": 22, "w": 12, "x": 12, "y": 14 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ntfy_topic_message_count{period=\"1h\"}",
          "legendFormat": "1u venster",
          "refId": "A"
        },
        {
          "expr": "ntfy_topic_message_count_by_priority{period=\"24h\", priority=~\"urgent|high\"}",
          "legendFormat": "{{priority}} (24u)",
          "refId": "B"
        }
      ]
    }
  ]
}
