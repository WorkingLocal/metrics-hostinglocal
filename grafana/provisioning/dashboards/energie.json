      },
      "targets": [{"expr":"homeassistant_sensor_energy_kwh{entity=\"sensor.homelab_verbruik_kwh_totaal\"}","legendFormat":"Homelab kWh","datasource":{"type":"prometheus","uid":"${datasource}"}}],
      "datasource": {"type":"prometheus","uid":"${datasource}"}
    }

  ],

  "templating": {
    "list": [
      {
        "name": "datasource", "type": "datasource", "pluginId": "prometheus",
