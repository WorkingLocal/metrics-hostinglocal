{
  "uid": "adguard-home-hostinglocal",
  "title": "AdGuard Home — DNS Monitor",
  "tags": ["adguard", "dns", "networking"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "schemaVersion": 36,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "DNS Queries (24h)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10000 },
              { "color": "red", "value": 50000 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "adguard_dns_queries_total{instance=\"VM-ADGUARD\"}",
          "legendFormat": "Queries",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Geblokkeerd (24h)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "adguard_blocked_total{instance=\"VM-ADGUARD\"}",
          "legendFormat": "Geblokkeerd",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Blokratio",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          },
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "adguard_block_ratio{instance=\"VM-ADGUARD\"}",
          "legendFormat": "Block %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Gem. Responstijd",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          },
          "unit": "ms"
        }
      },
      "targets": [
        {
          "expr": "adguard_avg_processing_time_ms{instance=\"VM-ADGUARD\"}",
          "legendFormat": "Responstijd",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Status",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "text": { "valueSize": 20 }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } }, "type": "value" }
          ]
        }
      },
      "targets": [
        {
          "expr": "adguard_running{instance=\"VM-ADGUARD\"}",
          "legendFormat": "Running",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Beveiliging",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "options": { "0": { "text": "UIT" }, "1": { "text": "AAN" } }, "type": "value" }
          ]
        }
      },
      "targets": [
        {
          "expr": "adguard_protection_enabled{instance=\"VM-ADGUARD\"}",
          "legendFormat": "Protection",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DNS Queries over tijd",
      "gridPos": { "x": 0, "y": 4, "w": 16, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "adguard_dns_queries_total{instance=\"VM-ADGUARD\"}",
          "legendFormat": "Totaal queries",
          "refId": "A"
        },
        {
          "expr": "adguard_blocked_total{instance=\"VM-ADGUARD\"}",
          "legendFormat": "Geblokkeerd",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "DNS Responstijd (ms)",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 8 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "adguard_avg_processing_time_ms{instance=\"VM-ADGUARD\"}",
          "legendFormat": "Gem. responstijd",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top Bevraagde Domeinen (24h)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": {
        "sortBy": [{ "displayName": "Waarde", "desc": true }],
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "domain" },
            "properties": [{ "id": "displayName", "value": "Domein" }, { "id": "custom.width", "value": 300 }]
          },
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [{ "id": "displayName", "value": "Queries" }]
          }
        ]
      },
      "targets": [
        {
          "expr": "topk(10, adguard_top_domain_queries{instance=\"VM-ADGUARD\"})",
          "legendFormat": "{{domain}}",
          "refId": "A",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": { "valueLabel": "domain" } },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true } } }
      ]
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "Blokratio",
      "gridPos": { "x": 12, "y": 12, "w": 6, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "targets": [
        {
          "expr": "adguard_block_ratio{instance=\"VM-ADGUARD\"}",
          "legendFormat": "Block %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Node Exporter — CPU & RAM (vm-adguard)",
      "gridPos": { "x": 18, "y": 12, "w": 6, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 5 },
          "unit": "percent",
          "min": 0, "max": 100
        }
      },
      "targets": [
        {
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=\"VM-ADGUARD\"}[5m])) * 100)",
          "legendFormat": "CPU %",
          "refId": "A"
        },
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes{instance=\"VM-ADGUARD\"} / node_memory_MemTotal_bytes{instance=\"VM-ADGUARD\"})) * 100",
          "legendFormat": "RAM %",
          "refId": "B"
        }
      ]
    }
  ]
}
