{
  "title": "Host Temperatures",
  "uid": "host-temperatures-hl",
  "description": "CPU, GPU en case temperaturen van alle fysieke Hosting Local hosts",
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 38,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["temperatures", "hardware"],
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "CPU Temperaturen — actueel",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "id": 2,
      "type": "stat",
      "title": "AI-NODE-I9 — CPU",
      "description": "Intel i9 MS-01 — Package temperatuur",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 85 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (instance) (node_hwmon_temp_celsius{instance=\"AI-NODE-I9\", chip=~\"coretemp.*\", sensor=~\"Package id.*|temp1\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "AI-NODE-I5 — CPU",
