          "refId": "A"
        },
        {
          "expr": "max by (instance) (windows_thermalzone_temperature_kelvin{instance=\"WINDOWSSERVER2025\"}) - 273.15",
          "legendFormat": "WINDOWSSERVER2025",
          "refId": "B"
        }
      ]
    },

