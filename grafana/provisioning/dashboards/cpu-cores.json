{
  "title": "CPU Cores — Alle Nodes",
  "uid": "cpu-cores-hl",
  "description": "Alle CPU cores van het volledige Hosting Local homelab op één pagina",
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["cpu", "cores", "homelab"],
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "Huidige Core Load — Snapshot",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "id": 2,
      "type": "bargauge",
      "title": "CPU % per Core — Alle Linux Nodes (huidige waarde)",
      "description": "Elke balk = één logische CPU-core op één node. Formaat: INSTANCE — coreN",
      "gridPos": { "h": 28, "w": 16, "x": 0, "y": 1 },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "text": { "valueSize": 12 }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]) * 100)",
          "legendFormat": "{{instance}} — core{{cpu}}",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 3,
      "type": "bargauge",
      "title": "CPU % per Core — Windows (alle cores)",
      "gridPos": { "h": 14, "w": 8, "x": 16, "y": 1 },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "text": { "valueSize": 12 }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - (rate(windows_cpu_time_total{mode=\"idle\"}[2m]) * 100)",
          "legendFormat": "WINDOWSSERVER — core{{core}}",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Gemiddelde CPU Load — Alle Linux Nodes",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 15 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "avg(100 - (avg by (instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100))",
          "legendFormat": "Gem. alle nodes",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Hoogste CPU Core — Linux",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 21 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(100 - (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]) * 100))",
          "legendFormat": "Hoogste core",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 10,
      "type": "row",
      "title": "CPU over Tijd — per Node (gemiddeld over cores)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "collapsed": false
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU % per Node — gemiddeld (Linux)",
      "description": "CPU-gebruik per node gemiddeld over alle cores. Gebruik de bargauge hierboven voor per-core detail.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 30 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 1, "fillOpacity": 5 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        },
        {
          "expr": "100 - (avg by (instance) (rate(windows_cpu_time_total{mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "{{instance}}",
          "refId": "B"
        }
      ]
    },

    {
      "id": 20,
      "type": "row",
      "title": "CPU Modes — VPS + AI Nodes (gedetailleerd)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "collapsed": false
    },

    {
      "id": 21,
      "type": "timeseries",
      "title": "CPU Modes — VM-AI-NODE-I9",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "avg by (mode) (rate(node_cpu_seconds_total{instance=\"VM-AI-NODE-I9\", mode!=\"idle\"}[5m])) * 100",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 22,
      "type": "timeseries",
      "title": "CPU Modes — VM-AI-NODE-I5",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "avg by (mode) (rate(node_cpu_seconds_total{instance=\"VM-AI-NODE-I5\", mode!=\"idle\"}[5m])) * 100",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    }

  ]
}
