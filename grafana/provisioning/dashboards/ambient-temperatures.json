    {
      "id": 2,
      "type": "stat",
      "title": "Terras Beneden — Buiten",
      "description": "TP357 Bluetooth sensor op het terras (buitentemperatuur)",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "orientation": "auto",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "super-light-blue", "value": 5 },
              { "color": "green", "value": 15 },
              { "color": "yellow", "value": 25 },
              { "color": "orange", "value": 32 },
              { "color": "red", "value": 38 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "homeassistant_sensor_temperature_celsius{entity=\"sensor.tp357_c5a9_temperature\", job=\"smarthomeserver\"}",
          "legendFormat": "Terras Beneden",
          "refId": "A"
        }
      ]
    },

