{
  "title": "Network Bandwidth — Homelab",
  "uid": "network-bandwidth-hl",
  "description": "iPerf3 bandbreedte metingen naar meerdere targets — fileserver, networkserver, windowsserver",
  "timezone": "browser",
  "refresh": "5m",
  "schemaVersion": 38,
  "version": 2,
  "time": { "from": "now-24h", "to": "now" },
  "tags": ["network", "iperf3", "bandwidth"],
  "templating": {
    "list": [
      {
        "name": "target",
        "label": "Target",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(network_iperf3_bits_per_second, target)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "multi": true,
        "sort": 1
      }
    ]
  },
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "Bandbreedte trend",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "id": 2,
      "type": "timeseries",
      "title": "Bandbreedte alle hosts — $target (laatste 24u)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max", "min"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "network_iperf3_bits_per_second{target=~\"$target\"}",
          "legendFormat": "{{hostname}} → {{target}} ({{interface_type}})",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "type": "row",
      "title": "Huidige snelheden",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "collapsed": false
    },

    {
      "id": 4,
      "type": "bargauge",
      "title": "Bandbreedte naar $target — laatste meting",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "max": 10000000000,
          "displayName": "${__field.labels.hostname} → ${__field.labels.target} (${__field.labels.interface_type})",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null        },
              { "color": "orange", "value": 100000000   },
              { "color": "yellow", "value": 500000000   },
              { "color": "green",  "value": 900000000   },
              { "color": "blue",   "value": 2000000000  }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "network_iperf3_bits_per_second{target=~\"$target\"}",
          "legendFormat": "{{hostname}} → {{target}}",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 5,
      "type": "row",
      "title": "Overzicht",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false
    },

    {
      "id": 6,
      "type": "table",
      "title": "Status alle hosts — laatste meting",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 23 },
      "options": {
        "sortBy": [{ "displayName": "Bandbreedte", "desc": true }],
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Bandbreedte" },
            "properties": [
              { "id": "unit", "value": "bps" },
              { "id": "custom.displayMode", "value": "color-background" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red",    "value": null        },
                    { "color": "orange", "value": 100000000   },
                    { "color": "yellow", "value": 500000000   },
                    { "color": "green",  "value": 900000000   },
                    { "color": "blue",   "value": 2000000000  }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "OK" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "1": { "text": "OK",   "color": "green" } } },
                { "type": "value", "options": { "0": { "text": "FAIL", "color": "red"   } } }
              ]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Laatste test" },
            "properties": [
              { "id": "unit", "value": "dateTimeFromNow" }
            ]
          }
        ]
      },
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "hostname":       "Host",
              "target":         "Target",
              "interface_type": "Verbinding",
              "interface":      "Interface",
              "Value #A":       "Bandbreedte",
              "Value #B":       "OK",
              "Value #C":       "Laatste test"
            },
            "indexByName": {
              "Host":        0,
              "Target":      1,
              "Verbinding":  2,
              "Interface":   3,
              "Bandbreedte": 4,
              "OK":          5,
              "Laatste test": 6
            },
            "excludeByName": {
              "Time": true, "__name__": true, "job": true, "instance": true
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "network_iperf3_bits_per_second{target=~\"$target\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "network_iperf3_success{target=~\"$target\"}",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "network_iperf3_last_run_timestamp{target=~\"$target\"} * 1000",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "format": "table"
        }
      ]
    }

  ]
}
