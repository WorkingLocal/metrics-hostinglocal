{
  "title": "Controllers — Signage & Kiosk",
  "uid": "controllers-hl",
  "description": "CPU, RAM en temperaturen van alle display controllers (Xibo signage, kiosks) — Working Local & Hosting Local",
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 38,
  "version": 1,
  "time": { "from": "now-3h", "to": "now" },
  "tags": ["controllers", "xibo", "signage", "workinglocal"],

  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Datasource",
        "hide": 0,
        "query": "prometheus",
        "current": {},
        "options": [],
        "refresh": 1
      }
    ]
  },

  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "Overzicht",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Controllers Online",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "auto",
        "text": { "valueSize": 48 }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(up{group=\"controllers\"} == 1)",
          "legendFormat": "Online",
          "refId": "A",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Controllers Offline",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "auto",
        "text": { "valueSize": 48 }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(up{group=\"controllers\"} == 0) OR vector(0)",
          "legendFormat": "Offline",
          "refId": "A",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 4,
      "type": "table",
      "title": "Status Overzicht",
      "gridPos": { "h": 4, "w": 16, "x": 8, "y": 1 },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "1": { "text": "Online", "color": "green" } } },
                { "type": "value", "options": { "0": { "text": "Offline", "color": "red" } } }
              ]}
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "up{group=\"controllers\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "transformations": [
        { "id": "labelsToFields", "options": { "valueLabel": "instance" } },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "group": true, "__name__": true } } }
      ]
    },

    {
      "id": 10,
      "type": "row",
      "title": "XIBO-SURFACE — Surface Pro 4 (Working Local Woonkamer)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },

    {
      "id": 11,
      "type": "stat",
      "title": "Status",
      "gridPos": { "h": 3, "w": 3, "x": 0, "y": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "1": { "text": "Online", "color": "green" }, "0": { "text": "Offline", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{instance=\"XIBO-SURFACE\"}",
          "legendFormat": "Status",
          "refId": "A",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 12,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 3, "w": 3, "x": 3, "y": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "green", "value": 3600 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "node_time_seconds{instance=\"XIBO-SURFACE\"} - node_boot_time_seconds{instance=\"XIBO-SURFACE\"}",
          "legendFormat": "Uptime",
          "refId": "A",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 13,
      "type": "stat",
      "title": "CPU Gebruik",
      "gridPos": { "h": 3, "w": 3, "x": 6, "y": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{instance=\"XIBO-SURFACE\", mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "CPU %",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 14,
      "type": "stat",
      "title": "RAM Gebruik",
      "gridPos": { "h": 3, "w": 3, "x": 9, "y": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes{instance=\"XIBO-SURFACE\"} / node_memory_MemTotal_bytes{instance=\"XIBO-SURFACE\"})) * 100",
          "legendFormat": "RAM %",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 15,
      "type": "stat",
      "title": "Temperatuur",
      "gridPos": { "h": 3, "w": 3, "x": 12, "y": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 65 },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (instance) (node_hwmon_temp_celsius{instance=\"XIBO-SURFACE\"})",
          "legendFormat": "Temp °C",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 16,
      "type": "stat",
      "title": "RAM Vrij",
      "gridPos": { "h": 3, "w": 3, "x": 15, "y": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 209715200 },
              { "color": "green", "value": 524288000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "node_memory_MemAvailable_bytes{instance=\"XIBO-SURFACE\"}",
          "legendFormat": "Vrij",
          "refId": "A",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 17,
      "type": "stat",
      "title": "Disk Gebruik /",
      "gridPos": { "h": 3, "w": 3, "x": 18, "y": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - (node_filesystem_avail_bytes{instance=\"XIBO-SURFACE\", mountpoint=\"/\", fstype!=\"tmpfs\"} / node_filesystem_size_bytes{instance=\"XIBO-SURFACE\", mountpoint=\"/\", fstype!=\"tmpfs\"} * 100)",
          "legendFormat": "Disk %",
          "refId": "A",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 18,
      "type": "timeseries",
      "title": "XIBO-SURFACE — CPU & Temperatuur (trend)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Temp °C" },
            "properties": [
              { "id": "unit", "value": "celsius" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{instance=\"XIBO-SURFACE\", mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "CPU %",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "max by (instance) (node_hwmon_temp_celsius{instance=\"XIBO-SURFACE\"})",
          "legendFormat": "Temp °C",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 19,
      "type": "timeseries",
      "title": "XIBO-SURFACE — RAM Gebruik (trend)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes{instance=\"XIBO-SURFACE\"} - node_memory_MemAvailable_bytes{instance=\"XIBO-SURFACE\"}",
          "legendFormat": "RAM Gebruikt",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "node_memory_MemAvailable_bytes{instance=\"XIBO-SURFACE\"}",
          "legendFormat": "RAM Vrij",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    }

  ]
}
