    {
      "id": 31,
      "type": "bargauge",
      "title": "Schijfgebruik %",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 32 },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
