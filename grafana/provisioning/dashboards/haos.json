        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (chart) (netdata_disk_space_GiB_average{instance=\"HAOS-NUC\", dimension=\"used\"}) / sum by (chart) (netdata_disk_space_GiB_average{instance=\"HAOS-NUC\", dimension=~\"used|avail\"}) * 100",
          "legendFormat": "{{chart}}",
          "refId": "A",
          "instant": true
