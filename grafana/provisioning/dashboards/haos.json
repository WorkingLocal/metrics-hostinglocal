      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "netdata_system_cpu_percentage_average{instance=\"HAOS-NUC\", dimension!~\"idle|guest.*\"}",
          "legendFormat": "{{dimension}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 13,
