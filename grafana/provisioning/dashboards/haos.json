{
  "title": "HAOS — Intel NUC",
  "uid": "haos-nuc-hl",
  "description": "Home Assistant OS op Intel NUC — monitoring via HA native Prometheus + System Monitor integratie",
  "timezone": "browser",
  "refresh": "2m",
  "schemaVersion": 38,
  "version": 2,
  "time": { "from": "now-3h", "to": "now" },
  "tags": ["haos", "home-assistant"],
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "Systeem",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "id": 2,
      "type": "stat",
      "title": "CPU Gebruik",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "homeassistant_sensor_unit_percent{entity=\"sensor.system_monitor_processor_use\", job=\"smarthomeserver\"}",
          "legendFormat": "CPU %",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "CPU Temperatuur",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "homeassistant_sensor_temperature_celsius{entity=\"sensor.system_monitor_processortemperatuur\", job=\"smarthomeserver\"}",
          "legendFormat": "°C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "RAM Gebruik",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "homeassistant_sensor_data_size_mib{entity=\"sensor.system_monitor_memory_use\", job=\"smarthomeserver\"} / (homeassistant_sensor_data_size_mib{entity=\"sensor.system_monitor_memory_use\", job=\"smarthomeserver\"} + homeassistant_sensor_data_size_mib{entity=\"sensor.system_monitor_memory_free\", job=\"smarthomeserver\"}) * 100",
          "legendFormat": "RAM %",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "RAM Gebruikt",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mebibytes",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "homeassistant_sensor_data_size_mib{entity=\"sensor.system_monitor_memory_use\", job=\"smarthomeserver\"}",
          "legendFormat": "MiB",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 6,
      "type": "stat",
      "title": "Schijf Gebruikt",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "homeassistant_sensor_data_size_gib{entity=\"sensor.system_monitor_disk_use\", job=\"smarthomeserver\"} / (homeassistant_sensor_data_size_gib{entity=\"sensor.system_monitor_disk_use\", job=\"smarthomeserver\"} + homeassistant_sensor_data_size_gib{entity=\"sensor.system_monitor_disk_free\", job=\"smarthomeserver\"}) * 100",
          "legendFormat": "Disk %",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 7,
      "type": "stat",
      "title": "Schijf Vrij",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "gibibytes",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "homeassistant_sensor_data_size_gib{entity=\"sensor.system_monitor_disk_free\", job=\"smarthomeserver\"}",
          "legendFormat": "GiB",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 10,
      "type": "row",
      "title": "CPU & Temperatuur over tijd",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU Gebruik & Temperatuur",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10, "spanNulls": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Temperatuur °C" },
            "properties": [
              { "id": "unit", "value": "celsius" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "homeassistant_sensor_unit_percent{entity=\"sensor.system_monitor_processor_use\", job=\"smarthomeserver\"}",
          "legendFormat": "CPU %",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "homeassistant_sensor_temperature_celsius{entity=\"sensor.system_monitor_processortemperatuur\", job=\"smarthomeserver\"}",
          "legendFormat": "Temperatuur °C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "RAM Gebruik over tijd",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mebibytes",
          "custom": { "lineWidth": 2, "fillOpacity": 15, "spanNulls": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Vrij" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Gebruikt" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "homeassistant_sensor_data_size_mib{entity=\"sensor.system_monitor_memory_use\", job=\"smarthomeserver\"}",
          "legendFormat": "Gebruikt",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "homeassistant_sensor_data_size_mib{entity=\"sensor.system_monitor_memory_free\", job=\"smarthomeserver\"}",
          "legendFormat": "Vrij",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 20,
      "type": "row",
      "title": "Netwerk",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },

    {
      "id": 21,
      "type": "timeseries",
      "title": "Netwerk Doorvoer (eno1)",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 15 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "MBs",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "spanNulls": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Ontvangen" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Verzonden" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "homeassistant_sensor_data_rate_mb_per_s{entity=\"sensor.system_monitor_network_throughput_in_eno1\", job=\"smarthomeserver\"}",
          "legendFormat": "Ontvangen",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "homeassistant_sensor_data_rate_mb_per_s{entity=\"sensor.system_monitor_network_throughput_out_eno1\", job=\"smarthomeserver\"}",
          "legendFormat": "Verzonden",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 30,
      "type": "row",
      "title": "Backup",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false
    },

    {
      "id": 31,
      "type": "stat",
      "title": "Laatste HA Backup",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 23 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "auto",
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "homeassistant_sensor_timestamp_seconds{entity=\"sensor.backup_last_attempted_automatic_backup\", job=\"smarthomeserver\"} * 1000",
          "legendFormat": "Backup",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    }

  ],

  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Datasource",
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  }
}
