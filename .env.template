# Kopieer naar .env en vul in. .env wordt NOOIT gecommit.

# Grafana
GRAFANA_ADMIN_PASSWORD=

# SMTP (Hostinger)
SMTP_PASSWORD=

# ntfy publisher token (Vaultwarden → Homelab - Infrastructure → "ntfy — publisher token homelab")
NTFY_PUBLISHER_TOKEN=
NTFY_URL=https://ntfy.hostinglocal.be

# Keycloak OIDC voor Grafana (Vaultwarden → VM-METRICS - OIDC Secret)
GRAFANA_OIDC_SECRET=

# UniFi Poller — lokale admin account op UDM Pro Max (geen SSO/2FA)
# Aanmaken: UniFi UI → Settings → Admins → Add Admin → "Local Access Only"
# Rol: Read Only is voldoende voor poller
# Sla op in Vaultwarden → "UniFi Poller - metrics-hostinglocal"
UNIFI_POLLER_USER=
UNIFI_POLLER_PASS=
